# Porta do servidor (use um proxy reverso com HTTPS na frente em produção)
PORT=3001

# Chave de assinatura dos JWT — gere uma com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SECRET_KEY=

# Token compartilhado pelos agentes de monitoramento (heartbeat/snapshot)
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MONITORING_TOKEN=

# Chave AES-256 (base64, 32 bytes) para criptografar senhas no banco. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NÃO troque depois de migrar os dados.
ENCRYPTION_KEY=

# Origens permitidas pelo CORS (separadas por vírgula). Ex.: https://klarke.suaempresa.com
ALLOWED_ORIGINS=
